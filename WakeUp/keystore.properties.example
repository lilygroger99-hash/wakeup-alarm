# Copy this file to `keystore.properties` (same folder, NOT committed to git) and fill in your values.
# When keystore.properties exists, `./gradlew bundleRelease` produces a signed .aab automatically.
# Never commit the keystore or this file with real passwords to version control.
storeFile=/absolute/path/to/your-upload-key.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
